{
  "name": "@agentbazaar/api",
  "version": "0.9.0",
  "description": "AgentBazaar core: NestJS + Fastify modular monolith with REST, MCP and A2A surfaces.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "cli": "tsx src/cli/index.ts",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:services": "vitest run --project services --passWithNoTests",
    "test:coverage": "vitest run --project unit --project integration --project e2e --coverage",
    "mutation": "stryker run",
    "mutation:critical": "stryker run stryker.critical.config.mjs"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "@agentbazaar/config": "workspace:*",
    "@agentbazaar/contracts": "workspace:*",
    "@agentbazaar/testkit": "workspace:*",
    "@anthropic-ai/sdk": "^1.5.0",
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-pgvector": "*",
    "@fastify/helmet": "^13.2.0",
    "@fastify/otel": "^0.21.4",
    "@fastify/rate-limit": "^11.2.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-fastify": "^12.3.3",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "~0.300.0",
    "@opentelemetry/instrumentation-http": "~0.300.0",
    "@opentelemetry/instrumentation-pg": "~0.77.0",
    "@opentelemetry/instrumentation-undici": "~0.34.0",
    "@opentelemetry/resources": "~3.0.0",
    "@opentelemetry/sdk-node": "~0.300.0",
    "@opentelemetry/sdk-trace": "~3.0.0",
    "@prometheus-io/client": "^0.16.1",
    "@temporalio/activity": "^1.25.0",
    "@temporalio/client": "^1.25.0",
    "@temporalio/worker": "^1.25.0",
    "@temporalio/workflow": "^1.25.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "iovalkey": "^0.4.0",
    "jose": "^6.2.15",
    "kafkajs": "^2.2.4",
    "nats": "^2.29.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@vitest/coverage-v8": "^5.1.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
