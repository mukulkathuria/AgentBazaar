{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "greeting",
        "search",
        "product_question",
        "availability",
        "customization",
        "ask_price",
        "make_offer",
        "accept",
        "order_status",
        "return_request",
        "complaint",
        "competitor_claim",
        "human_handoff",
        "injection_attempt",
        "off_topic",
        "unknown"
      ]
    },
    "complexity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "hi",
        "hinglish",
        "other"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "entities": {
      "type": "object",
      "properties": {
        "amount_inr": {
          "type": [
            "number",
            "null"
          ]
        },
        "quantity": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "amount_inr",
        "quantity"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "string"
    }
  },
  "required": [
    "intent",
    "complexity",
    "risk",
    "language",
    "confidence",
    "entities",
    "model"
  ],
  "additionalProperties": false
}
