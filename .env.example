# AgentBazaar configuration. Copy to .env and fill in. Never commit .env.
# Generate the four keys with:  pnpm --filter @agentbazaar/api cli keys

PROFILE=lite                     # lite | growth | scale
NODE_ENV=production
PUBLIC_API_URL=https://api.shop.example.com
PUBLIC_WEB_URL=https://shop.example.com
SITE_DOMAIN=shop.example.com
API_DOMAIN=api.shop.example.com
CORS_ORIGINS=https://shop.example.com

# Database (lite runs Postgres in Compose)
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Growth (--profile growth): send the API through PgBouncer and serve safe reads from the streaming replica.
# DATABASE_HOST=pgbouncer:6432
# DATABASE_REPLICA_URLS=postgres://agentbazaar:<POSTGRES_PASSWORD>@postgres-replica:5432/agentbazaar
# DATABASE_REPLICA_MAX_LAG_MS=5000   # a replica further behind than this serves no reads until it catches up

# Keys (required in production)
QUOTE_SIGNING_KEY=
PII_MASTER_KEY=
PII_BLIND_INDEX_KEY=
JWT_PRIVATE_KEY=

# Payments: mock | razorpay | youpi-pg (experimental). Switching to live keys is a human decision.
PAYMENT_ADAPTER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# LLM: template (no keys) | anthropic | openai-compatible
LLM_ADAPTER=template
ANTHROPIC_API_KEY=
LLM_SMALL_MODEL=claude-haiku-5-5
LLM_LARGE_MODEL=claude-sonnet-5-5
# Model routing (docs/ai-routing.md): output-token cap per call for tier 2 (small) and tier 3 (large), and a
# second provider (anthropic | openai-compatible, with its own models) used while the first is down
LLM_TIER2_MAX_TOKENS=350
LLM_TIER3_MAX_TOKENS=350
LLM_FALLBACK_ADAPTER=none
LLM_FALLBACK_SMALL_MODEL=
LLM_FALLBACK_LARGE_MODEL=
# Reuse of guarded model wording: off | memory | valkey (growth). Numbers always come from the policy (ADR 0012)
SEMANTIC_CACHE=off
SEMANTIC_CACHE_THRESHOLD=0.9
# Optional Langfuse tracing of model calls (PII-redacted): set all three or none
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Seller details for GST invoices (confirm with your CA)
SELLER_NAME=Your Store Pvt Ltd
SELLER_GSTIN=
SELLER_STATE_CODE=DL
GRIEVANCE_OFFICER_EMAIL=grievance@shop.example.com

# Analytics store: postgres (default) or clickhouse (fed from the outbox; needs CLICKHOUSE_URL with user, password and database)
ANALYTICS_ADAPTER=postgres
CLICKHOUSE_URL=

# Web
ANALYTICS_INGEST_KEY=
WEB_REVALIDATE_SECRET=
AI_CRAWLERS_ALLOW=GPTBot,ClaudeBot,PerplexityBot,Google-Extended

# Growth / scale (only when PROFILE requires them)
MEILISEARCH_URL=
MEILISEARCH_API_KEY=
NATS_URL=
OPENBAO_ADDR=
OPENBAO_TOKEN=
KAFKA_BROKERS=
OPENSEARCH_URL=
QDRANT_URL=
# Checkout and payment saga (scale): inprocess | temporal. temporal needs TEMPORAL_ADDRESS and a
# `cli workflow-worker` process (compose: temporal:7233). See docs/architecture/sagas.md.
WORKFLOW_ENGINE=inprocess
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agentbazaar-checkout
# OpenTelemetry tracing starts only when this is set (OTLP/HTTP protobuf, e.g. http://otel-collector:4318)
OTEL_EXPORTER_OTLP_ENDPOINT=
