# AgentBazaar configuration. Copy to .env and fill in. Never commit .env.
# Generate the four keys with:  pnpm --filter @agentbazaar/api cli keys

PROFILE=lite                     # lite | growth | scale
NODE_ENV=production
PUBLIC_API_URL=https://api.shop.example.com
PUBLIC_WEB_URL=https://shop.example.com
SITE_DOMAIN=shop.example.com
API_DOMAIN=api.shop.example.com
CORS_ORIGINS=https://shop.example.com

# Database (lite runs Postgres in Compose)
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Keys (required in production)
QUOTE_SIGNING_KEY=
PII_MASTER_KEY=
PII_BLIND_INDEX_KEY=
JWT_PRIVATE_KEY=

# Payments: mock | razorpay | youpi-pg (experimental). Switching to live keys is a human decision.
PAYMENT_ADAPTER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# LLM: template (no keys) | anthropic | openai-compatible
LLM_ADAPTER=template
ANTHROPIC_API_KEY=
LLM_SMALL_MODEL=claude-haiku-5-5
LLM_LARGE_MODEL=claude-sonnet-5-5

# Seller details for GST invoices (confirm with your CA)
SELLER_NAME=Your Store Pvt Ltd
SELLER_GSTIN=
SELLER_STATE_CODE=DL
GRIEVANCE_OFFICER_EMAIL=grievance@shop.example.com

# Web
ANALYTICS_INGEST_KEY=
WEB_REVALIDATE_SECRET=
AI_CRAWLERS_ALLOW=GPTBot,ClaudeBot,PerplexityBot,Google-Extended

# Growth / scale (only when PROFILE requires them)
MEILISEARCH_URL=
MEILISEARCH_API_KEY=
NATS_URL=
OPENBAO_ADDR=
OPENBAO_TOKEN=
KAFKA_BROKERS=
OPENSEARCH_URL=
QDRANT_URL=
# Checkout and payment saga (scale): inprocess | temporal. temporal needs TEMPORAL_ADDRESS and a
# `cli workflow-worker` process (compose: temporal:7233). See docs/architecture/sagas.md.
WORKFLOW_ENGINE=inprocess
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agentbazaar-checkout
# OpenTelemetry tracing starts only when this is set (OTLP/HTTP protobuf, e.g. http://otel-collector:4318)
OTEL_EXPORTER_OTLP_ENDPOINT=
